{
  "name": "@lrydzkowski/api-authenticator",
  "version": "1.0.18",
  "description": "A console app generating an access token for APIs protected by OAuth 2.0 protocol",
  "main": "dist/index.js",
  "bin": {
    "api-authenticator": "./dist/index.js"
  },
  "scripts": {
    "generate-token": "tsx index.ts generate-token",
    "resolve-secrets": "tsx index.ts resolve-secrets",
    "build": "tsc",
    "lint": "oxlint .",
    "test": "tsx node_modules/jasmine/bin/jasmine",
    "prettier": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lrydzkowski/api-authenticator"
  },
  "author": "lrydzkowski",
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@commander-js/extra-typings": "^15.0.0",
    "fluentvalidation-ts": "^5.0.0",
    "oauth4webapi": "^3.8.7",
    "puppeteer": "25.9.0"
  },
  "type": "module",
  "devDependencies": {
    "@types/jasmine": "^6.0.0",
    "@types/node": "^24.13.3",
    "jasmine": "^7.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "ts-mockito": "^2.6.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
